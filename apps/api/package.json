{
  "name": "@infinite-canvas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@hono/node-server": "^1.19.9",
    "@infinite-canvas/canvas-core": "workspace:*",
    "@infinite-canvas/contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "file-type": "^21.3.4",
    "hono": "^4.12.7",
    "pg": "^8.16.3",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0"
  }
}
